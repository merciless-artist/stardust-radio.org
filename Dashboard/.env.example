# ============================================================
#  Stardust Radio — environment template
#  Copy this file to `.env` and fill in your real values.
#  Never commit `.env` — it holds secrets. Only this template
#  (`.env.example`) goes in source control.
# ============================================================


# ── Station identity ────────────────────────────────────────

# Display name shown in the header + browser tab.
STATION_NAME=Stardust Radio

# Hex color for accents (buttons, focus rings, glow).
# Try #ff4dd2 (magenta), #00e5ff (cyan), #b388ff (lavender).
ACCENT_COLOR=#ff4dd2


# ── AzuraCast (the streaming engine) ────────────────────────

# Public URL — where LISTENERS' BROWSERS reach AzuraCast.
# In production this is your Cloudflare-Tunnel hostname.
# Must include https://.
AZURACAST_BASE=https://radio.yourdomain.com

# Internal URL — where THIS SERVER reaches AzuraCast on the
# same machine (faster; skips the tunnel round-trip). Leave
# as http://localhost unless AzuraCast runs elsewhere.
AZURACAST_INTERNAL=http://localhost

# The "shortcode" of your AzuraCast station — visible in the
# AzuraCast admin under the station's profile.
#   Stream URL:   {AZURACAST_BASE}/listen/{SHORTCODE}/radio.mp3
#   Now-playing:  {AZURACAST_BASE}/api/nowplaying/{SHORTCODE}
AZURACAST_STATION_SHORTCODE=stardust_radio


# ── Flask server ────────────────────────────────────────────

# Local bind. Keep at 127.0.0.1 — Cloudflare Tunnel reaches
# in via localhost. Binding to 0.0.0.0 exposes the dashboard
# on your LAN for no reason.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080

# Secret key for signing Flask session cookies. Generate one
# with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=


# ── Discord OAuth (host sign-in for the DJ booth) ───────────

# Create a Discord application at https://discord.com/developers/applications
# Under OAuth2 > General, add your redirect URI (below) to the allowed list.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=https://yourdomain.com/booth/auth/callback

# The Discord server (guild) where DJs live, and the role that
# grants booth access. Right-click the server / role in Discord
# (Developer Mode on) → Copy ID.
DISCORD_GUILD_ID=
DISCORD_DJ_ROLE_ID=


# ── Discord bot / webhook (optional) ────────────────────────

# Bot token — only needed if you want the dashboard to reach
# Discord's REST API (e.g. to list a guild's channels).
DISCORD_BOT_TOKEN=

# Webhook — the dashboard's /api/announce endpoint posts here
# when a DJ hits "Announce" during a listening party.
DISCORD_WEBHOOK_URL=

# Optional path to a booth logo image shown on /booth.
DJ_LOGO_PATH=


# ── MySQL (only used by DJ booth's queue) ──────────────────
#
# The public listener site does NOT need MySQL. These are only
# read by the /booth (DJ) side of the app when managing the
# listening-party queue. Leave blank if you're only running the
# listener site.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
