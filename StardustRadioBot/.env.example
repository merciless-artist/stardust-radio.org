# Stardust Radio Bot — copy this to `.env` and fill in real values.
# The real .env is gitignored; never commit it.

# Discord bot token
TOKEN=your-discord-bot-token

# Shared database (the same MariaDB the dashboard reads)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-db-password
MYSQL_DATABASE=lp_dashboard

SUPER_ADMIN_ID=000000000000000000

# AzuraCast (centralized radio submissions)
AZURACAST_BASE=https://radio.stardust-radio.org
AZURACAST_API_KEY=your-azuracast-api-key
AZURACAST_STATION_ID=14
AZURACAST_SUBMISSIONS_PLAYLIST_ID=22
RADIO_SUBMIT_CHANNEL_ID=000000000000000000
RADIO_APPROVER_ROLE_ID=000000000000000000

# Voice + support
AZURACAST_STREAM_URL=https://radio.stardust-radio.org/listen/main/radio.mp3
SUPPORT_INVITE_URL=https://discord.gg/your-invite
DASHBOARD_URL=https://stardust-radio.org
